{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.tourit.ca/share/sitemap.xml"
    },
    {
      "source": "/share/:path*",
      "destination": "https://api.tourit.ca/share/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
